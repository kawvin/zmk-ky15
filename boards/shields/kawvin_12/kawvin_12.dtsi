#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

// 鼠标灵敏度（只定义一次！）
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20   // 滚轮速度

// 鼠标快捷宏（必须放在头文件之后！）
// 鼠标指针移动快捷宏
#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT

// 鼠标滚轮滚动快捷宏（新增！）
// #define U_WH_U &mscrl SCRL_UP    // 滚轮向上
// #define U_WH_D &mscrl SCRL_DOWN  // 滚轮向下
// #define U_WH_L &mscrl SCRL_LEFT  // 滚轮向左（水平滚动）
// #define U_WH_R &mscrl SCRL_RIGHT // 滚轮向右（水平滚动）

// 编码器 = 滚轮上下（原生 ZMK 语法，无任何冲突！）
#define ENC_SCROLL_UP &mscrl SCRL_UP
#define ENC_SCROLL_DOWN &mscrl SCRL_DOWN

// 新版 ZMK 指针滚轮（推荐！更流畅）(新版写法)
//#define U_WH_U &pointer_vel y -120
//#define U_WH_D &pointer_vel y 120
//#define U_WH_L &pointer_vel x -120
//#define U_WH_R &pointer_vel x 120

// 鼠标按键（可选，方便使用）
#define U_MB1 &mk LMB  // 鼠标左键
#define U_MB2 &mk RMB  // 鼠标右键
#define U_MB3 &mk MMB  // 鼠标中键

/ {
    // 👇 必须加：定义按键扫描矩阵（4行3列，适配你的ky12键盘）
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        
        // 行引脚（根据你的键盘实际接线修改）
        // row-gpios
        //     = <&gpio0 22 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
        //     , <&gpio0 24 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
        //     , <&gpio1  4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
        //     , <&gpio1  6 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>
        //     ;
        // 列引脚（根据你的键盘实际接线修改）
        // col-gpios
        //     = <&gpio0 20 GPIO_ACTIVE_HIGH>
        //     , <&gpio0 17 GPIO_ACTIVE_HIGH>
        //     , <&gpio0 31 GPIO_ACTIVE_HIGH>
        //     ;
    };

    // 👇 必须加：矩阵转换
    matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <4>;
        map = <
            RxC(0,0) RxC(0,1) RxC(0,2) RxC(0,3)
            RxC(1,0) RxC(1,1) RxC(1,2)
            RxC(2,0) RxC(2,1) RxC(2,2)
            RxC(3,0) RxC(3,1) RxC(3,2)
        >;
    };

    // 你的物理布局
    ky12_layout: ky12_layout {
        compatible = "zmk,physical-layout";
        display-name = "ky12v3";

        kscan = <&kscan0>;
        transform = <&matrix_transform0>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100  100  300       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            ;
    };

    chosen {
        physical-layouts = &ky12_layout;
    };
};

// USB 配置
&usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
};