#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200 // 10

//#include "kawvin_15.dtsi"
#include <behaviors/mouse_move.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>


&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 2>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };
};


/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        // 同时按 0 + 1 → ESC

        esc_01 {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <200>;
        };

        // 同时按 1 + 2 → ESC

        esc_02 {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            timeout-ms = <200>;
        };

        // 在2、5层同时按 2 + 9 → bootloader
        flash {
            bindings = <&bootloader>;
            key-positions = <2 9>;
            timeout-ms = <200>;
            layers = <2 5>;
        };
    };

    macros {
        potplay_c5: potplay_c5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp C &kp C &kp C &kp C>;
            label = "POTPLAY_C5";
        };

        potplay_x5: potplay_x5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp X &kp X &kp X &kp X>;
            label = "POTPLAY_X5";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            //  ---------------------------------------------------------------------------------
            //  |HOME |UP        |PG_UP |
            //  |LEFT |DOWN      |RIGHT |
            //  |END  |ENTER     |PG_DN |
            //  |TAB  |BSPC      |LA(F4)|
            //  |&to 1|&ltq 2 DEL|ENTER |

            bindings = <
                &kp HOME  &kp UP      &kp PG_UP   
                &kp LEFT  &kp DOWN    &kp RIGHT   
                &kp END   &kp ENTER   &kp PG_DN   
                &kp TAB   &kp BSPC    &kp LA(F4)  
                &to 1     &ltq 2 DEL  &kp ENTER   
            >;

            label = "Qwerty";
            sensor-bindings = <&scroll_encoder>;
        };

        number_layer {
            //  ---------------------------------------------------------------------------------
            //  |N1   |N2 |N3   |
            //  |N4   |N5 |N6   |
            //  |N7   |N8 |N9   |
            //  |N0   |N0 |DOT  |
            //  |&to 2|N0 |ENTER|


            bindings = <
                &kp N1  &kp N2  &kp N3      
                &kp N4  &kp N5  &kp N6      
                &kp N7  &kp N8  &kp N9      
                &kp N0  &kp N0  &kp KP_DOT  
                &to 2   &kp N0  &kp ENTER   
            >;

            label = "Number";
            sensor-bindings = <&scroll_encoder>;
        };

        mouse_layer {
            //  ---------------------------------------------------------------------------------
            //  |&mkp LCLK     |&mmv MOVE_UP  |&mkp RCLK      |
            //  |&mmv MOVE_LEFT|&mmv MOVE_DOWN|&mmv MOVE_RIGHT|
            //  |BT_SEL 0      |ENTER         |BT_CLR         |
            //  |BT_SEL 1      |BT_SEL 2      |&studio_unlock |
            //  |&to 3         |              |ENTER          |


            bindings = <
                &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        
                &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  
                &bt BT_SEL 0    &kp ENTER       &bt BT_CLR       
                &bt BT_SEL 1    &bt BT_SEL 2    &studio_unlock   
                &to 3           &trans          &kp ENTER        

            >;

            label = "Mouse";
            sensor-bindings = <&scroll_encoder>;
        };

        play_layer {
            //  ---------------------------------------------------------------------------------
            //  |&mt T LC(LEFT)|UP    |&mt PG_UP LC(RIGHT)|
            //  |LEFT          |DOWN  |RIGHT              |
            //  |&mt R LS(LEFT)|SPACE |&mt PG_DN LS(RIGHT)|
            //  |E             |G     |BACKSPACE      |
            //  |&to 4         |N1    |ENTER              |


            bindings = <
                &mt T LC(LEFT)  &kp UP     &mt PG_UP LC(RIGHT)  
                &kp LEFT        &kp DOWN   &kp RIGHT            
                &mt R LS(LEFT)  &kp SPACE  &mt PG_DN LS(RIGHT)  
                &kp E           &kp G      &kp BACKSPACE        
                &to 4           &kp N1     &kp ENTER            

            >;

            label = "Play";
            sensor-bindings = <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>;
        };

        read_layer {
            //  ---------------------------------------------------------------------------------
            //  |HOME |UP   |PG_UP |
            //  |LEFT |DOWN |RIGHT |
            //  |END  |SPACE|PG_DN |
            //  |ESC  |SPACE|LA(F4)|
            //  |&to 5|ENTER|ENTER |



            bindings = <
                &kp HOME  &kp UP     &kp PG_UP   
                &kp LEFT  &kp DOWN   &kp RIGHT   
                &kp END   &kp SPACE  &kp PG_DN   
                &kp ESC   &kp SPACE  &kp LA(F4)  
                &to 5     &kp ENTER  &kp ENTER   

            >;

            label = "Read";
            sensor-bindings = <&scroll_encoder>;
        };

        chrome_layer {
            //  ---------------------------------------------------------------------------------
            //  |&mt LC(N1) HOME|UP     |&mt LC(N9) PG_UP|
            //  |LEFT           |DOWN   |RIGHT           |
            //  |END            |SPACE  |PG_DN           |
            //  |LC(LS(TAB))    |LC(TAB)|LC(W)           |
            //  |&to 0          |LC(W)  |ENTER           |


            bindings = <
                &mt LC(N1) HOME  &kp UP       &mt LC(N9) PG_UP  
                &kp LEFT         &kp DOWN     &kp RIGHT         
                &kp END          &kp SPACE    &kp PG_DN         
                &kp LC(LS(TAB))  &kp LC(TAB)  &kp LC(W)         
                &to 0            &kp LC(W)    &kp ENTER         

             >;

            label = "Chrome";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
